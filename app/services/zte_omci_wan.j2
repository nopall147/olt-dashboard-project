interface gpon-olt_1/{{ slot }}/{{ port }}
  onu {{ onu_id }} type {{ actual_type }} sn {{ sn_onu }}
!
interface gpon-onu_1/{{ slot }}/{{ port }}:{{ onu_id }}
  name {{ nama_pelanggan }}
  tcont 1 name INTERNET profile {{ profil_paket }}
  gemport 1 name INTERNET tcont 1
  switchport mode hybrid vport 1
  service-port 1 vport 1 user-vlan {{ vlan_id }} vlan {{ vlan_id }}
!
pon-onu-mng gpon-onu_1/{{ slot }}/{{ port }}:{{ onu_id }}
  service INTERNET gemport 1 vlan {{ vlan_id }}
  wan-ip 1 mode pppoe username {{ pppoe_user }} password {{ pppoe_pass }}
!